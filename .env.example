# Variables públicas y secretos necesarios en Cloudflare Pages.
# Copia los nombres en Settings > Variables and Secrets.
# Nunca confirmes un archivo .env real ni claves de producción en Git.

ENVIRONMENT=production
ALLOWED_ORIGINS=https://afropxmusic.com,https://www.afropxmusic.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=AfroPX <reservas@afropxmusic.com>
BOOKING_NOTIFICATION_EMAIL=contacto@afropxmusic.com

# Debe ser una cadena aleatoria larga y exclusiva de producción.
RATE_LIMIT_SALT=

# Cloudflare Access para /admin/* y /api/admin/*
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_EMAILS=
ADMIN_BYPASS=false

ADMIN_URL=https://afropxmusic.com/admin/
