{
  "name": "afropx-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Web oficial de AfroPX y plataforma de reservas de Pedro / Audio.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-site.mjs",
    "images": "node scripts/images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run check",
    "verify": "npm run build && npm run lint && npm test",
    "dev": "npm run build && wrangler pages dev dist --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "jose": "6.2.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.28.1",
    "jsqr": "1.4.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22"
  }
}
