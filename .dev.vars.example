# Copia este archivo como `.dev.vars` para desarrollo local.
# No incluyas secretos reales en Git.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:8788

# Turnstile: usa claves de prueba oficiales o activa el bypass SOLO en local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=true

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=AfroPX <reservas@afropxmusic.com>
BOOKING_NOTIFICATION_EMAIL=contacto@afropxmusic.com

# Protección y privacidad
RATE_LIMIT_SALT=replace-with-a-long-local-random-value

# Cloudflare Access para /admin y /api/admin/*
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_EMAILS=
ADMIN_BYPASS=true

# URL pública del panel incluida en los correos internos
ADMIN_URL=http://127.0.0.1:8788/admin/
